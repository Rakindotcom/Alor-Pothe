# আলোর পথে (Alor Pothe) — Environment Variables Template
# Copy this file to .env.local and fill in your values.

# 1. Firebase Client SDK (Public Web Config for Real-Time Read Subscriptions)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# 2. Firebase Admin SDK (Server-Only Atomic Writes & Admin Operations)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. Admin Panel Protection (Server-Only)
ADMIN_PIN="change-this-secret-pin"
ADMIN_SESSION_SECRET="replace-with-64-char-random-hex-secret"

# 4. Optional Shared Family Access Code
# Leave FAMILY_ACCESS_CODE empty and NEXT_PUBLIC_REQUIRE_FAMILY_CODE="false"
# for frictionless elder access, or set a code to require it on submission.
FAMILY_ACCESS_CODE=""
NEXT_PUBLIC_REQUIRE_FAMILY_CODE="false"
